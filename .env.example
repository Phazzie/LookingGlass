# Gemini AI API key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Neon PostgreSQL connection string (required for production)
# Get this from your Neon project dashboard → Connection Details → pooled connection
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_secret_here
NEXTAUTH_URL=http://localhost:3000

# Admin credentials (single-user login)
ADMIN_EMAIL=admin@example.com
# Generate hash with:
#   node -e "require('bcryptjs').hash('yourpassword', 12).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=$2b$12$example_bcrypt_hash_here
